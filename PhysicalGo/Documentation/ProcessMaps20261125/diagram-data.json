  {
    "key": "calibration",
    "title": "2 \u00b7 Two calibrations, then permission to play",
    "desc": "A grid fit maps pixels to intersections. A motor fit maps encoder poses to the laser spot. Neither proves current clearance.",
    "height": 1120,
    "nodes": [
      {
        "id": "select",
        "x": 50,
        "y": 30,
        "w": 300,
        "h": 96,
        "title": "Select actual app camera",
        "body": "Verify device, dimensions, epoch\nand advancing presentation times",
        "kind": "process"
      },
      {
        "id": "grid",
        "x": 50,
        "y": 205,
        "w": 300,
        "h": 96,
        "title": "Fit camera \u2192 board grid",
        "body": "Find intersections / perspective\nValidate boundaries + interior",
        "kind": "process"
      },
      {
        "id": "ref",
        "x": 50,
        "y": 380,
        "w": 300,
        "h": 96,
        "title": "Retain geometry/reference",
        "body": "Native board coordinate system\nLighting / occupancy references",
        "kind": "process"
      },
      {
        "id": "measure",
        "x": 400,
        "y": 205,
        "w": 300,
        "h": 96,
        "title": "Measure pointer \u2192 board",
        "body": "Observe spot at measured poses\nAttended, guarded motor samples",
        "kind": "process"
      },
      {
        "id": "fit",
        "x": 400,
        "y": 380,
        "w": 300,
        "h": 96,
        "title": "Fit candidate motor map",
        "body": "Predict target pose; quantify fit\nNot a physical test of 361 points",
        "kind": "process"
      },
      {
        "id": "check",
        "x": 400,
        "y": 555,
        "w": 300,
        "h": 96,
        "title": "Independent optical checks",
        "body": "Separate targets + actual spot\nReject moved / invalid setup",
