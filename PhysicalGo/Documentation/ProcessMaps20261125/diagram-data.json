  {
    "key": "gameplay",
    "title": "4 \u00b7 AI game and physical placement",
    "desc": "The AI move enters legal history before its stone is physically placed. pendingPlacement preserves that difference.",
    "height": 1170,
    "nodes": [
      {
        "id": "resume",
        "x": 50,
        "y": 30,
        "w": 300,
        "h": 96,
