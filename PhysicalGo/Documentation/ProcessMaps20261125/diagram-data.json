  {
    "key": "data",
    "title": "3 \u00b7 Camera, processing and file boundaries",
    "desc": "Native safety and pixels use separate lanes. Host request and status loops are independent. Optional stage traces measure cost. Recording caches immutable manifest context; gaps stay journaled and do not trigger full rewrites.",
    "height": 1220,
    "nodes": [
      {
        "id": "capture",
        "x": 50,
        "y": 30,
        "w": 300,
        "h": 96,
        "title": "Camera serial queue",
        "body": "AVFoundation presentation time\nCapture + arrival + epoch/frame ID",
        "kind": "process"
      },
      {
        "id": "main",
        "x": 50,
        "y": 215,
        "w": 300,
        "h": 96,
        "title": "Main actor: session snapshot",
        "body": "Camera/grid/reference/expected board\nRevision rejects stale completions",
        "kind": "process"
      },
      {
        "id": "vision",
        "x": 400,
        "y": 215,
        "w": 300,
        "h": 96,
        "title": "Serial vision worker",
        "body": "Physical wood / grid / hand support\nThen stone/shape/assignment evidence",
        "kind": "process"
      },
      {
        "id": "latest",
        "x": 400,
        "y": 30,
        "w": 300,
        "h": 96,
        "title": "Latest-only pending input",
        "body": "One replaceable waiting frame\nNo accumulated analysis backlog",
        "kind": "store"
      },
      {
        "id": "safety",
        "x": 750,
        "y": 215,
        "w": 300,
        "h": 96,
        "title": "Early safety \u2192 main actor",
        "body": "Current revision + actual timestamps\nIndependent of geometry exclusions",
        "kind": "process"
      },
      {
        "id": "observe",
        "x": 400,
        "y": 430,
        "w": 300,
        "h": 96,
        "title": "Final observation \u2192 game",
        "body": "Same immutable analysis context\nGame applies own dark/stable gates",
        "kind": "process"
      },
      {
        "id": "png",
        "x": 50,
        "y": 430,
        "w": 300,
        "h": 96,
        "title": "Image preparation / broker",
        "body": "PNG work overlaps analysis\nCache key: epoch + frame ID",
        "kind": "process"
      },
      {
        "id": "manifest",
        "x": 50,
        "y": 630,
        "w": 300,
        "h": 96,
        "title": "Image queue \u2192 latest.json",
        "body": "Publish exact checked PNG first\nOne pending; retain four PNGs",
        "kind": "store"
      },
      {
        "id": "safejson",
        "x": 750,
        "y": 430,
        "w": 300,
        "h": 96,
        "title": "Safety queue \u2192 safety.json",
        "body": "Separate atomic publication\nNo matching pixels promised",
        "kind": "store"
      },
      {
        "id": "io",
        "x": 400,
        "y": 630,
        "w": 300,
        "h": 96,
        "title": "Request / status IO queues",
        "body": "One read + one write in flight\nOne replaceable pending request",
        "kind": "store"
      },
      {
        "id": "reader",
        "x": 50,
        "y": 840,
        "w": 300,
        "h": 96,
        "title": "Host optical worker",
        "body": "Read matching PNG + manifest\nCheck four ages \u2264600 ms",
        "kind": "gate"
      },
      {
        "id": "supervisor",
        "x": 750,
        "y": 630,
        "w": 300,
        "h": 96,
        "title": "Host safety supervision",
        "body": "Hand / camera / lease / thermal\nCan revoke busy optical worker",
        "kind": "process"
      },
      {
        "id": "status",
        "x": 400,
        "y": 840,
        "w": 300,
        "h": 96,
        "title": "Host request reader",
        "body": "Dedicated bounded request read\nGate checks identity / lease / stop",
        "kind": "process"
      },
      {
        "id": "publisher",
        "x": 50,
        "y": 1050,
        "w": 300,
        "h": 96,
        "title": "Host status writer: one owner",
        "body": "No queue; skip concurrent publish\nOld snapshot fenced at replacement",
        "kind": "process"
      },
      {
        "id": "reread",
        "x": 400,
        "y": 1050,
        "w": 300,
        "h": 96,
        "title": "Raw expiry: one newer reread",
        "body": "Same scope; newer frame ID + capture\nOriginal 600 ms checks stay in force",
        "kind": "process"
      },
      {
        "id": "stopfence",
        "x": 750,
        "y": 1050,
        "w": 300,
        "h": 96,
        "title": "Stop fences on background I/O",
        "body": "Before snapshot / lease poll / rename\nOnly close may publish final OFF",
        "kind": "gate"
      }
    ],
