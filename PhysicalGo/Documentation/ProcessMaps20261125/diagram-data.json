      },
      {
        "id": "ready",
        "x": 750,
        "y": 730,
        "w": 300,
        "h": 96,
        "title": "Attended READY gate",
        "body": "Recheck package + camera \u00d73\nExact controller identity + free port",
        "kind": "gate"
      },
      {
        "id": "launch",
        "x": 750,
        "y": 915,
        "w": 300,
        "h": 96,
        "title": "Open one host / controller",
        "body": "OFF handshake \u2192 capability check\nThen current session admission",
        "kind": "process"
      },
      {
        "id": "moved",
        "x": 50,
        "y": 730,
        "w": 300,
        "h": 96,
        "title": "If board/camera/pointer moves",
        "body": "Requalify affected relationships\nA matching file hash is insufficient",
        "kind": "fault"
